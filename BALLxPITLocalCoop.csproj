<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BALLxPITLocalCoop</AssemblyName>
    <RootNamespace>BALLxPITLocalCoop</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0</InformationalVersion>
    <Authors>Hyrule</Authors>
    <Company>Hyrule</Company>
    <Product>BALLxPIT: Local Coop</Product>
    <Copyright>Hyrule (Open Source)</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GameDir Condition="'$(GameDir)' == ''">G:\Games\steamapps\common\BALLxPIT</GameDir>
    <NoWarn>CS0618;CS0649;CS0169;CS0414;NETSDK1138</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)\dotnet\*.dll"
               Exclude="$(GameDir)\dotnet\coreclr.dll;$(GameDir)\dotnet\clrjit.dll;$(GameDir)\dotnet\clretwrc.dll;$(GameDir)\dotnet\dbgshim.dll;$(GameDir)\dotnet\hostfxr.dll;$(GameDir)\dotnet\hostpolicy.dll;$(GameDir)\dotnet\Microsoft.DiaSymReader.Native.amd64.dll;$(GameDir)\dotnet\mscordaccore*.dll;$(GameDir)\dotnet\mscordbi.dll;$(GameDir)\dotnet\mscorrc.dll;$(GameDir)\dotnet\msquic.dll;$(GameDir)\dotnet\System.IO.Compression.Native.dll"
               Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\*.dll"
               Exclude="$(GameDir)\BepInEx\core\dobby.dll"
               Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll"
               Exclude="$(GameDir)\BepInEx\interop\mscorlib.dll;$(GameDir)\BepInEx\interop\System*.dll;$(GameDir)\BepInEx\interop\netstandard.dll;$(GameDir)\BepInEx\interop\Mono*.dll"
               Private="false" />
  </ItemGroup>
  <Target Name="DeployToBepInEx" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins" SkipUnchangedFiles="true" />
  </Target>
</Project>
